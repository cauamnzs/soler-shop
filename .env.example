# =====================================================================
# SOLER SHOP — Variáveis de Ambiente (Front-end Vite)
# =====================================================================
# COMO USAR: Copie este arquivo para ".env.local" e preencha os valores.
# O Vite carrega automaticamente .env.local no modo dev/build.
# Variáveis com prefixo VITE_* são INJETADAS NO BUNDLE e expostas ao browser.
# NUNCA coloque chaves secretas (service_role, access tokens) com VITE_*.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE (OBRIGATÓRIAS — Front-end Público)
# ---------------------------------------------------------------------
# Endereço do seu projeto no Supabase (Project Settings → API → URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima pública (anon public key) — PODE ficar exposta no front
# Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_ANON_AQUI

# ---------------------------------------------------------------------
# 2. DADOS DE CONTATO (Substituem hardcodes da versão anterior)
# ---------------------------------------------------------------------
# Número WhatsApp com DDI + DDD + número (apenas dígitos, sem + ou -)
# Usado em: CTA sticky mobile, botão flutuante, modal produto, rodapé
VITE_WHATSAPP_NUMBER=5513991234567

# Handle do Instagram SEM o @ (apenas o username)
# Usado em: Rodapé, Feed Instagram (header + watermark das fotos)
VITE_INSTAGRAM_HANDLE=solershop_

# Email de contato exibido no rodapé e formulários
VITE_CONTACT_EMAIL=contato@solershop.com.br

# ---------------------------------------------------------------------
# 3. INFORMAÇÕES DO NEGÓCIO (Marca e Dados Legais)
# ---------------------------------------------------------------------
# Localização / subtítulo do Hero — exibido na home
VITE_BUSINESS_LOCATION=Santos / Ilhabela — Envio Nacional

# Nome completo da empresa (páginas administrativas, termos, NF)
VITE_BUSINESS_NAME=Soler Shop Importados

# CNPJ (apenas dígitos) — aparecerá no rodapé / checkout / NF-e
VITE_BUSINESS_CNPJ=00000000000100

# ---------------------------------------------------------------------
# 4. CONFIGURAÇÕES DE FRETE (Usadas no resumo do carrinho e checkout)
# ---------------------------------------------------------------------
# Valor do frete fixo em CENTAVOS de BRL (2990 = R$ 29,90)
VITE_SHIPPING_FLAT_RATE=2990

# Valor mínimo do pedido (em CENTAVOS) para FRETE GRÁTIS
# 49900 = R$ 499,00
VITE_FREE_SHIPPING_THRESHOLD=49900

# ---------------------------------------------------------------------
# 5. MERCADO PAGO — Integração de Pagamentos (CLIENT-SAFE)
# ---------------------------------------------------------------------
# PUBLIC KEY (SDK JS front-end) — PODE ficar exposta no browser.
# Tipo: Client-safe | Prefixo VITE_* injetado no bundle do Vite.
# Mercado Pago → Credenciais → Chave pública (Public Key).
# Formato: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MP_PUBLIC_KEY=

# (Compatibilidade legado — se existir, usa como fallback)
VITE_MERCADO_PAGO_PUBLIC_KEY=

# ---------------------------------------------------------------------
# 6. PAINEL ADMINISTRATIVO (Whitelist de emails autorizados)
# ---------------------------------------------------------------------
# Lista de emails separados por vírgula que podem acessar /admin
# Exemplo: "dono@solershop.com.br,financeiro@solershop.com.br"
# DEIXE VAZIO até que o painel admin seja implementado.
VITE_ADMIN_EMAILS=

# =====================================================================
# 🔐 CHAVES SECRETAS (SERVER-ONLY — NÃO USAR PREFIXO VITE_*)
# =====================================================================
# As variáveis ABAIXO NÃO usam prefixo VITE_ e NÃO devem existir em
# nenhum arquivo de ambiente enviado ao cliente.
#
# Configure-as diretamente no painel da Vercel:
#   Project Settings → Environment Variables → "Production / Preview"
# Ou localmente via shell / .env.local (esse arquivo já está no
# .gitignore e NUNCA vai para commits).
# =====================================================================

# 7. MERCADO PAGO (SERVER-ONLY)
# Access Token (credencial secreta) — NUNCA exponha no front-end.
# Tipo: Server-only
# Mercado Pago → Credenciais → Token de acesso (Access Token / Prod.)
# Formato: APP_USR-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_ACCESS_TOKEN=

# Webhook Secret (autenticação de notificações MP)
# Tipo: Server-only
# Valide manualmente no painel MP (Webhooks → Configurar Segredo).
# Gere um valor aleatório forte (ex: openssl rand -hex 32)
MP_WEBHOOK_SECRET=

# 8. SUPABASE SERVICE ROLE (SERVER-ONLY — opcional)
# Chave privilegiada service_role do Supabase.
# Tipo: Server-only
# SÓ use em endpoints /api para funções administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# ⛔ NÃO ALTERE A ORDEM ACIMA / NÃO REMOVA COMENTÁRIOS DE TIPO.
# Essa documentação protege contra commit acidental de segredos.
# =====================================================================
